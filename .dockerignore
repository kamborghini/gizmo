# The image runs Python only. Nothing else needs to be inside it, and anything
# that is there is code shipped to production that nobody reviews.
node_modules/
.venv/
venv/
__pycache__/
*.pyc
.git/
.shopify/
extensions/
tests/
# Not code: docs, the icon source set, the sample env and the captured debug
# dumps. None of it runs, so none of it belongs in a production image.
docs/
feather/
README.md
env.example
*.txt
!requirements.txt
.github/
