# The app's direct dependencies, pinned exactly. This is the file to edit.
# `make lock` compiles it into requirements.txt: every package the app ends up
# installing, transitive ones included, pinned with hashes. The image, CI and
# `make install` install that file, so a build installs exactly what was
# tested and a tampered download is refused.
# These were once unbounded (">="), so any redeploy could pull a new major
# release with no change on our side. To upgrade: raise a pin here, run
# `make lock`, run `make check`, and check /healthz after the deploy.
# The newest 1.x: mcp supports only its newest 1.x and 2.x releases. The [cli]
# extra installed a command-line tool nothing here runs.
mcp==1.30.0
httpx==0.28.1
pydantic==2.13.5
uvicorn==0.54.0
anthropic==1.11.0
PyJWT==2.15.1
beautifulsoup4==4.15.0
# [requests]: the service-account sign-in (google_data._sa_refresh_sync) reaches
# Google through google.auth.transport.requests, imported only when it runs.
# requests was dropped on 2026-09-07 as unused, which no import scan could see
# and the local environment hid (pip-audit pulls it in there): a fresh deploy
# could not sign in that way at all. Same trap as Pillow below.
google-auth[requests]==2.59.1
pypdfium2==5.13.0
# Nothing here imports PIL, and removing this pin broke the label printer in
# CI: pypdfium2 rasterises a page through Pillow (page.render().to_pil()) and
# only finds out at call time. An import scan cannot see that; the test suite
# run against a fresh install can, and did.
pillow==12.3.0

# Transitive dependencies pinned to their security floors. These are pulled in by
# mcp / uvicorn / google-auth rather than named by us, so nothing constrained them
# and each deploy resolved whatever was current: a moving, unaudited set under the
# app. Pinned after `pip-audit` found live advisories in every one of them.
#   starlette         request.url rebuilt from an unvalidated path; form() limits
#                     not enforced on every path (PYSEC-2026-248 / 249)
#   python-multipart  negative Content-Length turned a bounded read into
#                     read-until-EOF; querystring parsing flaws (PYSEC-2026-3036/37/40)
#   cryptography      statically linked OpenSSL fix, cert-chain blowup, wildcard
#                     name-constraint bypass (GHSA-537c-gmf6-5ccf and others)
#   pyasn1            quadratic OID decoding and unbounded tag ids (PYSEC-2026-3455/56/57)
#   pydantic-settings symlink escape from secrets_dir (GHSA-4xgf-cpjx-pc3j)
starlette==1.7.0
python-multipart==0.0.32
cryptography==50.0.2
pyasn1==0.6.4
pydantic-settings==2.15.0
boto3==1.43.107

# The serial sticker's two codes, generated SERVER-side and placed as data:
# URIs. The app's own CSP allows no CDN scripts, so a browser QR library was
# never an option, and hand-rolling Code 128 from a remembered pattern table
# risks unscannable labels on machines that are already out with customers.
# Both are pure Python, MIT, and pull nothing else in.
segno==1.6.6
python-barcode==0.16.1
