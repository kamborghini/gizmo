# gizmo - environment variables
#
# The complete reference, with every variable the code reads and its default,
# is docs/ENVIRONMENT.md (generated from the code; `make env-doc`). This file
# is the short version: what a deployment needs, grouped by what it turns on.
#
# Locally: copy to .env and fill in; `make run` loads it. In production the
# variables live in Railway, and nowhere else - never in the code, never in a
# chat, never in a document. Every path defaults to the Railway volume (/data).

# ---- Shopify (required) ---------------------------------------------------
SHOPIFY_STORE=my-store                  # the part before .myshopify.com
SHOPIFY_ACCESS_TOKEN=                   # shpat_... from a custom app, OR the pair below
SHOPIFY_CLIENT_ID=                      # OAuth client credentials (auto-refresh)
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_KEY=                        # the embedded app's client id (App Bridge)
SHOPIFY_API_SECRET=                     # verifies session tokens and webhook signatures
SHOPIFY_API_VERSION=2026-07

# ---- The assistant --------------------------------------------------------
ANTHROPIC_API_KEY=                      # chat, overview, SEO, audits; off when blank
# ANTHROPIC_MODEL_FAST=claude-sonnet-4-6
# ANTHROPIC_MODEL_DEEP=claude-opus-4-8
# ANTHROPIC_EFFORT=max
# DAILY_COST_CAP=                       # USD per day across every model call

# ---- Security -------------------------------------------------------------
MCP_BEARER_TOKEN=                       # locks /mcp; the endpoint answers 503 until set
TOKEN_ENCRYPTION_KEY=                   # seals OAuth tokens, MFA secrets and courier
                                        # credentials at rest; losing it means
                                        # reconnecting, not data loss
# LOG_DRAIN_URL=                        # https only; audit ledger and logs off the box
# LOG_DRAIN_TOKEN=
# MASTER_RESET=                         # break-glass: logs a starter password at boot.
                                        # REMOVE after use.

# ---- Where things live (all default to the volume) -----------------------
# PROFILE_PATH=/data/store_profile.json
# GOBO_SIZES_LIVE=/data/gobo-sizes.csv          # the uploaded size sheet
# GOBO_OVERRIDES_LIVE=/data/gobo-overrides.csv  # rules saved in the app
# GOBO_ALIASES_LIVE=/data/gobo-aliases.csv
# DISPATCH_ARCHIVE_PATH=/data/dispatch_state_archive.jsonl   # evicted dispatch records
# BACKUP_SNAPSHOT_DIR=/data/snapshots

# ---- Integrations (each is off until its variables are set) ---------------
# Google: OAuth for the merchant's own account (Search Console, GA4, Gmail)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_CONNECT_SECRET=                  # gate for the one-time /oauth/*/start links
GA4_PROPERTY_ID=
GSC_SITE_URL=
# Xero (reconciliation)
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# World Options courier - prefer entering these in Settings; env wins if set
# WO_METER_NUMBER=
# WO_KEY=
# WO_PASSWORD=
# Cloudflare R2 (the Files tab and the drive)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Pipedrive import
# PIPEDRIVE_API_TOKEN=
# PIPEDRIVE_DOMAIN=
# Alert email (Resend)
# RESEND_API_KEY=
# ALERT_EMAIL_FROM=
# ALERT_EMAIL_TO=
# The Xero connector service, over Railway's private network
# CONNECTOR_URL=http://<service>.railway.internal:8080
# CONNECTOR_TOKEN=
# The stock app (zeta)
# ZETA_URL=
# ZETA_SYNC_TOKEN=

# ---- Server ---------------------------------------------------------------
PORT=8000
# MCP_TRANSPORT=streamable-http
# APP_URL=                              # public base URL when not on Railway
# RATE_LIMIT_PER_CLIENT=120             # and the rest of the tuning knobs: see docs/ENVIRONMENT.md
